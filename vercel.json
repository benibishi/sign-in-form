{
  "version": 2,
  "builds": [
    {
      "src": "**/*.{html,css,js}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/css/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/js/$1"
    },
    {
      "src": "/config/(.*)",
      "headers": { "cache-control": "public, max-age=0, must-revalidate" },
      "dest": "/config/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
